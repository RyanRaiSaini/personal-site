{
  "name": "personal-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "resume": "node scripts/build-resume-pdf.mjs",
    "resume:image": "node scripts/resume-image.mjs",
    "photos": "node scripts/optimize-photos.mjs",
    "shots": "node scripts/shots.mjs",
    "stadium:pack": "node scripts/pack-stadium.mjs",
    "stadium:build": "node scripts/blender.mjs --background --factory-startup --python blender/build.py -- --blend {work}/bernabeu-stadium.blend --site public/stadium",
    "stadium:assets": "node scripts/fetch-polyhaven.mjs",
    "players:build": "node scripts/blender.mjs --background --factory-startup --python blender/build_players.py -- --source {work}/mixamo/source --blend {work}/mixamo/footballer.blend --site public/players",
    "players:check": "node scripts/blender.mjs --background {work}/mixamo/footballer.blend --python blender/check_players.py",
    "players:pack": "node scripts/pack-players.mjs",
    "crowd:build": "node scripts/blender.mjs --background --factory-startup --python blender/build_crowd.py -- --source {work}/mixamo/raw --site public/stadium/crowd",
    "crowd:build:back": "node scripts/blender.mjs --background --factory-startup --python blender/build_crowd.py -- --source {work}/mixamo/raw --site public/stadium/crowd --back",
    "crowd:build:queue": "node scripts/blender.mjs --background --factory-startup --python blender/build_crowd.py -- --source {work}/mixamo/raw --site public/stadium/crowd --stand",
    "crowd:pack": "node scripts/pack-crowd.mjs",
    "peek": "node scripts/peek.mjs",
    "measure": "node scripts/measure.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "next": "16.4.6",
    "postprocessing": "^6.39.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "meshoptimizer": "^1.3.0",
    "pdfkit": "^0.20.2",
    "puppeteer-core": "^25.18.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
